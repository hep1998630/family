# Copy this file to .env.local and fill in your own Supabase project's
# values (Supabase dashboard -> Project Settings -> Data API).
#
# NEXT_PUBLIC_SUPABASE_URL is the project's base URL only — do NOT add a
# /rest/v1 suffix, the Supabase client libraries add that themselves.
#   correct:   https://<project-id>.supabase.co
#   incorrect: https://<project-id>.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co

# The anon/public key (safe to expose in the browser bundle — it has no
# access beyond what the database's RLS policies allow).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
